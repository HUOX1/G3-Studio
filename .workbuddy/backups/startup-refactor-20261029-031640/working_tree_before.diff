+func _g3_startup_reveal() -> void:
+	_g3_startup_diag("reveal_enter")
+	# Keep the native window at its 1x1 transparent boot size until a frame renders.
+	# A timer prevents an invisible app if rendering callbacks do not arrive.
+	get_tree().create_timer(4.0).timeout.connect(_g3_startup_force_reveal, CONNECT_ONE_SHOT)
+	await get_tree().process_frame
+	await get_tree().process_frame
+	if _g3_startup_revealed:
+		return
+	var win := get_window()
+	if win == null:
+		return
+	_g3_startup_diag("before_apply_window_mode")
+	# Never show the 1x1 boot surface: prepare the final window while hidden.
+	_apply_startup_window_mode()
+	_g3_startup_diag("after_apply_window_mode")
+	# Let deferred window sizing settle before preparing the first full frame.
+	await get_tree().process_frame
+	if _g3_startup_revealed:
+		return
+	_g3_startup_diag("before_transparency_off")
+	get_viewport().transparent_bg = false
+	win.transparent = false
+	win.min_size = Vector2i(1244, 700)
+	_g3_startup_diag("after_transparency_off")
+	# Render at the final size before revealing the native window.
+	# The existing timeout covers systems that skip draws for hidden windows.
+	await RenderingServer.frame_post_draw
+	_g3_startup_diag("after_first_post_draw")
+	_g3_startup_finish_reveal()
+
+func _g3_startup_force_reveal() -> void:
+	_g3_startup_diag("timeout_force_reveal")
+	if _g3_startup_revealed:
+		return
+	_apply_startup_window_mode()
+	# Timeout fallback must not reveal a 1x1 window before deferred sizing.
+	_set_windowed_size()
+	_g3_startup_finish_reveal()
+
+func _g3_startup_finish_reveal() -> void:
+	_g3_startup_diag("finish_reveal_enter")
+	if _g3_startup_revealed:
+		return
+	var win := get_window()
+	if win == null:
+		return
+	_g3_startup_revealed = true
+	get_viewport().transparent_bg = false
+	win.transparent = false
+	win.min_size = Vector2i(1244, 700)
+	win.unfocusable = false
+	win.grab_focus()
+	_g3_startup_diag("ready_signal_about_to_write")
+	_g3_signal_external_startup_ready()
+
+func _g3_signal_external_startup_ready() -> void:
+	var ready_path: String = OS.get_environment("G3_STARTUP_READY_FILE")
+	if ready_path.is_empty():
+		return
+	var ready_file := FileAccess.open(ready_path, FileAccess.WRITE)
+	if ready_file == null:
+		push_warning("G3 startup launcher: could not write the readiness signal.")
+		return
+	ready_file.store_string("ready")
+	ready_file.close()
