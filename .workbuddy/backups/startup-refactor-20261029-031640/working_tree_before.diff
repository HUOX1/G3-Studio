+func get_field_settings(key: String, scope: String = "movies") -> Dictionary:
+	var fs: Dictionary = _current.get(scope, {})
+	var fields = fs.get("fields", {})
+	if not (fields is Dictionary):
+		return {}
+	var entry = fields.get(key, {})
