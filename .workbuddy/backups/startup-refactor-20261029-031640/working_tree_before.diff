+func _g3_startup_diag(stage: String) -> void:
+	var diag_path: String = OS.get_environment("G3_STARTUP_DIAG_FILE")
+	if diag_path.is_empty():
+		return
+	var win := get_window()
+	if win == null:
+		return
+	var line := "t_ms=%d stage=%s window_size=%s native_size=%s position=%s mode=%d transparent=%s borderless=%s unfocusable=%s viewport_transparent=%s renderer=%s" % [
+		Time.get_ticks_msec(), stage, str(win.size), str(DisplayServer.window_get_size()),
+		str(win.position), int(win.mode), str(win.transparent), str(win.borderless),
+		str(win.unfocusable), str(get_viewport().transparent_bg),
+		str(ProjectSettings.get_setting("rendering/renderer/rendering_method", "unknown"))
+	]
+	var file := FileAccess.open(diag_path, FileAccess.READ_WRITE)
+	if file == null:
+		file = FileAccess.open(diag_path, FileAccess.WRITE)
+	if file != null:
+		file.seek_end()
+		file.store_line(line)
+		file.close()
 
